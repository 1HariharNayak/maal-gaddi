{
  "expo": {
    "name": "Maal Gaddi",
    "slug": "maal-gaddi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "maalgaddi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F8FAFC"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maalgaddi.app",
      "config": {
        "googleMapsApiKey": ""
      }
    },
    "android": {
      "package": "com.maalgaddi.app",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Maal Gaddi to use your location to set pickup points."
        }
      ]
    ]
  }
}
