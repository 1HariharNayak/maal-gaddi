# Maal Gaddi Mobile Frontend Environment Variables
# API Base URL (Point to your local backend development server)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Google Maps Platform API Key
# Enabled APIs required:
# 1. Maps SDK for Android
# 2. Maps SDK for iOS
# 3. Geocoding API
# 4. Places API (New)
# For local development without a key, the app gracefully falls back to device GPS and standard coordinates.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
